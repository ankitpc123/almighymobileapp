                    <ContentPresenter
                        Grid.Row="0"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand" />

                    <ContentView
                        Grid.Row="1"
                        BackgroundColor="{DynamicResource ThemeBaseColor}"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">
                        <local:AnimatedLabel
                            Style="{DynamicResource RegularLable}"
                            Text="हम नहीं दिगंबर, श्वेताम्बर, तेरापंथी, स्थानकवासी हम एक धर्म के अनुयायी, हम एक देव के विश्वासी हम जैनी - अपना जैन धर्म, इतना ही परिचय केवल हो हम यही कामना करते है, ऐसा आने वाला कल हो"
                            TextColor="White" />
                    </ContentView>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="MainPageBackTemplate">
                <Grid
                    Margin="0"
                    Padding="0"
                    RowDefinitions="*">
                    <ContentPresenter
                        Grid.Row="0"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand" />
                </Grid>
            </ControlTemplate>

        </ResourceDictionary>
    </Application.Resources>

