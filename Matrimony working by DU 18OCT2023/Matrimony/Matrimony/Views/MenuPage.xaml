<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Matrimony.Views.MenuPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ffTransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
    xmlns:ffimage="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Menu"
    mc:Ignorable="d">

    <StackLayout VerticalOptions="FillAndExpand">
        <!--<StackLayout TranslationY="-15" Orientation="Vertical" VerticalOptions="Start" HorizontalOptions="CenterAndExpand">
            <Button Text="CLICK HERE" Clicked="OnUserProfileTap" TextColor="White" BackgroundColor="{StaticResource NavigationPrimary}" Margin="10,20"/>
        </StackLayout>-->
        <ListView
            x:Name="ListViewMenu"
            HasUnevenRows="False"
            RowHeight="-1"
            SeparatorVisibility="None"
            VerticalOptions="EndAndExpand">
            <ListView.Header>
                <StackLayout Padding="10,5,0,5" BackgroundColor="{DynamicResource NavigationPrimary}">
                    <ffimage:CachedImage
                        Grid.Row="0"
                        Margin="2"
                        Aspect="AspectFit"
                        HeightRequest="92"
                        HorizontalOptions="Start"
                        Source="namste"
                        WidthRequest="92">
                        <ffimage:CachedImage.Transformations>
                            <ffTransformations:RoundedTransformation
                                BorderHexColor="#FFFFFF"
                                BorderSize="10"
                                CropHeightRatio="42"
                                CropWidthRatio="42"
                                Radius="500" />
                        </ffimage:CachedImage.Transformations>
                    </ffimage:CachedImage>
                    <Label
                        HorizontalOptions="Start"
                        Style="{DynamicResource BoldLable}"
                        Text="JAI JINENDRA"
                        TextColor="White" />
                </StackLayout>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid
                            Padding="14,2,14,2"
                            ColumnDefinitions="30,*"
                            ColumnSpacing="20"
                            RowDefinitions="30,1">
                            <ffimageloadingsvg:SvgCachedImage
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="4"
                                HeightRequest="16"
                                Source="{Binding IconSource}"
                                WidthRequest="16" />
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                FontSize="12"
                                HorizontalOptions="StartAndExpand"
                                Style="{DynamicResource RegularLable}"
                                Text="{Binding Title}"
                                TextColor="{DynamicResource ThemeTextColor}" />
                            <BoxView
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                BackgroundColor="{DynamicResource ThemeTextColor}"
                                Opacity="0.5" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Label
            x:Name="lblVersion"
            FontSize="10"
            Style="{DynamicResource RegularLable}"
            VerticalOptions="End" />
    </StackLayout>

</ContentPage>