<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Matrimony.Views.PJKSMenu.TESTSearchPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cards="clr-namespace:PanCardView;assembly=PanCardView"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ffTransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
    xmlns:ffimage="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    xmlns:local="clr-namespace:Matrimony.NewFolder"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:proc="clr-namespace:PanCardView.Processors;assembly=PanCardView"
    xmlns:tabview="clr-namespace:Xam.Plugin.TabView;assembly=Xam.Plugin.TabView"
    Title="{Binding Title}"
    ControlTemplate="{StaticResource MainPageBackTemplate}"
    mc:Ignorable="d">
    <ContentPage.ToolbarItems>
        <!--<ToolbarItem Order="Secondary" Text="About-us" />
        <ToolbarItem Order="Secondary" Text="Contact-us" />
        <ToolbarItem Order="Secondary" Text="Help" />-->
    </ContentPage.ToolbarItems>
    <NavigationPage.TitleView>
        <Grid
            Margin="0,0,8,0"
            BackgroundColor="Transparent"
            ColumnDefinitions="*,48"
            RowDefinitions="48">

            <StackLayout
                Grid.Column="0"
                HorizontalOptions="CenterAndExpand"
                Orientation="Horizontal"
                VerticalOptions="Center">
                <Label
                    Style="{DynamicResource MediumLable}"
                    Text="पारसजनकल्याण संस्थान की जानकारी"
                    TextColor="White" />
            </StackLayout>
            <ffimage:CachedImage
                Grid.Column="1"
                Margin="2"
                Aspect="AspectFit"
                HeightRequest="42"
                Source="girl"
                WidthRequest="42">
                <ffimage:CachedImage.Transformations>
                    <ffTransformations:RoundedTransformation
                        BorderHexColor="#FFFFFF"
                        BorderSize="10"
                        CropHeightRatio="42"
                        CropWidthRatio="42"
                        Radius="500" />
                </ffimage:CachedImage.Transformations>
            </ffimage:CachedImage>

        </Grid>
    </NavigationPage.TitleView>

    <Grid Padding="10,4,10,2" RowDefinitions="60,*,100">
        <Grid
                Grid.Row="0"
                Padding="12,6,12,0"
                ColumnDefinitions="40,*,40"
                HorizontalOptions="FillAndExpand"
                RowDefinitions="48,Auto"
                VerticalOptions="Center">
            <Frame
                    Grid.ColumnSpan="2" Grid.Row="0"
                    Padding="8,4,8,4"
                    BorderColor="White"
                    CornerRadius="10"
                    HasShadow="True">
                <StackLayout Orientation="Horizontal">

                    <ffimageloadingsvg:SvgCachedImage
                            Grid.Column="2"
                            HeightRequest="12"
                            Source="resource://Matrimony.Resources.search.svg"
                            WidthRequest="12" />

                    <Entry
                            x:Name="txtSearch"
                            Grid.Column="1"
                            x:FieldModifier="Public"
                            Completed="Search_Tapped"
                            FontSize="12"
                            HeightRequest="36"
                            HorizontalOptions="FillAndExpand"
                            Keyboard="Default"
                            Placeholder="Search..."
                            ReturnType="Search"
                            Style="{DynamicResource RegularEntry}"
                            Text=""
                            TextChanged="txtSearch_TextChanged"
                            TextColor="{DynamicResource ThemeTextColor}" />

                </StackLayout>
            </Frame>
            <ContentView
                    Grid.Column="2"
                    Padding="2"
                    HeightRequest="40">
                <ffimageloadingsvg:SvgCachedImage Grid.Column="2" Source="resource://Matrimony.Resources.add.svg" />
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="AddMember_Tapped" />
                </ContentView.GestureRecognizers>
            </ContentView>

            <Button InputTransparent="False"
                     Grid.Row="0"
                    Grid.Column="1" 
                    BackgroundColor="Transparent"
                    FontSize="12" VerticalOptions="CenterAndExpand"
                    HorizontalOptions="EndAndExpand" TranslationX="16"
                    FontFamily="{StaticResource MediumFont}"
                    Text="खोजें"
                    TextColor="Black" Clicked="AdvanceSearch_Tapped"
                    />

        </Grid>
        <tabview:TabViewControl
            Grid.Row="1"
            HeaderBackgroundColor="White"
            HeaderSelectionUnderlineColor="{DynamicResource ThemeBaseColor}"
            HeaderSelectionUnderlineThickness="2"
            HeaderTabTextColor="{DynamicResource ThemeTextColor}"
            HeaderTabTextFontAttributes="Bold"
            HeaderTabTextFontFamily="{DynamicResource MediumFont}"
            HeaderTabTextFontSize="16"
            HorizontalOptions="FillAndExpand"
            IsSwipeEnabled="True"
            TabHeaderSpacing="0"
            VerticalOptions="FillAndExpand">
            <tabview:TabViewControl.ItemSource>
                <tabview:TabItem
                    HeaderTabTextFontFamily="{DynamicResource RegularFont}"
                    HeaderTabTextFontSize="12"
                    HeaderText="कार्यकारिणी">

                    <CollectionView
    HorizontalOptions="FillAndExpand"
    ItemsSource="{Binding PJKSGroupCommitteeMembersList}"
    
    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label
            Style="{DynamicResource MediumLable}"
            Text="No Record Available"
            TextColor="{DynamicResource ThemeTextColor}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <ContentView
                Margin="10"
                Padding="2,2"
                BackgroundColor="Transparent">
                                    <Frame
                    Margin="0,0"
                    Padding="2,4,2,4"
                    BackgroundColor="White"
                    BorderColor="White"
                    CornerRadius="10"
                    HasShadow="True">
                                        <Grid
                        ColumnDefinitions="Auto,2.5*"
                        ColumnSpacing="14"
                        RowDefinitions="16,14,14,14,14,1,20"
                        RowSpacing="1">
                                            <ImageButton
                            Grid.Row="0"
                            Grid.RowSpan="7"
                            Grid.Column="0"
                            Margin="2"
                            Aspect="Fill"
                            BackgroundColor="Transparent"
                            Clicked="PJKSTapGestureRecognizer_Tapped"
                            CornerRadius="15"
                            Source="{Binding ImageUrl}"
                            WidthRequest="100" />

                                            <Label 
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            HorizontalOptions="StartAndExpand"
                            Style="{DynamicResource BoldLable}"
                            Text="{Binding MemberNo, StringFormat='सदस्य क्रं:{0}'}"
                            TextColor="{DynamicResource ThemeTextColor}" />

                                            <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            FontSize="10"
                            HorizontalOptions="StartAndExpand"
                            Style="{DynamicResource RegularLable}"
                            Text="{Binding FirstName}"
                            TextColor="{DynamicResource ThemeTextColor}" />

                                            <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            FontSize="10"
                            HorizontalOptions="StartAndExpand"
                            Style="{DynamicResource RegularLable}"
                            Text="{Binding GetAddress}"
                            TextColor="{DynamicResource ThemeTextColor}" />

                                            <Label
                            Grid.Row="3"
                            Grid.Column="1"
                            FontSize="10"
                            HorizontalOptions="StartAndExpand"
                            Style="{DynamicResource RegularLable}"
                            Text="{Binding Mobile, StringFormat='मोबाइल | {0}'}"
                            TextColor="{DynamicResource ThemeTextColor}" />

                                            <Label
                            Grid.Row="4"
                            Grid.Column="1"
                            FontSize="10"
                            HorizontalOptions="StartAndExpand"
                            Style="{DynamicResource RegularLable}"
                            Text="{Binding GetAddress}"
                            TextColor="{DynamicResource ThemeTextColor}" />
                                            <BoxView
                        Grid.Row="5"
                        Grid.Column="1"
                        BackgroundColor="{DynamicResource ThemeTextColor}"
                        HeightRequest="1"
                        HorizontalOptions="FillAndExpand" />
                                            <StackLayout
                            Grid.Row="6"
                            Grid.Column="1"
                            HorizontalOptions="EndAndExpand"
                            Orientation="Horizontal"
                            TranslationY="6"
                            VerticalOptions="Fill">
                                                <Frame
                                Padding="0"
                                BackgroundColor="{DynamicResource ThemeBaseColor}"
                                CornerRadius="6"
                                HasShadow="False"
                                HeightRequest="12"
                                Opacity="0.75"
                                WidthRequest="120">
                                                    <Label
                                    FontSize="12"
                                    Style="{DynamicResource BoldLable}"
                                    Text="शुभकामनायें भेजें"
                                    TextColor="White" />
                                                    <Frame.GestureRecognizers>
                                                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="HappyWishes_Tapped" />
                                                    </Frame.GestureRecognizers>
                                                </Frame>
                                            </StackLayout>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="HappyWishesMember_Tapped" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </Frame>
                                </ContentView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
