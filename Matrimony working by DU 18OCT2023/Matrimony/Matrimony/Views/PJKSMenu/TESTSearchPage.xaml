                                                CornerRadius="15"
                                                Source="{Binding ImageUrl}"
                                                WidthRequest="100" />

                                            <Label 
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                FontSize="12"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{DynamicResource BoldLable}"
                                                Text="{Binding MemberNo, StringFormat='सदस्य क्रं:{0}'}"
                                                TextColor="{DynamicResource ThemeTextColor}" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                FontSize="10"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{DynamicResource RegularLable}"
                                                Text="{Binding FirstName}"
                                                TextColor="{DynamicResource ThemeTextColor}" />

                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                FontSize="10"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{DynamicResource RegularLable}"
                                                Text="{Binding GetAddress}"
                                                TextColor="{DynamicResource ThemeTextColor}" />

                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                FontSize="10"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{DynamicResource RegularLable}"
                                                Text="{Binding Mobile, StringFormat='मोबाइल | {0}'}"
                                                TextColor="{DynamicResource ThemeTextColor}" />

                                            <Label
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                FontSize="10"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{DynamicResource RegularLable}"
                                                Text="{Binding GetAddress}"
                                                TextColor="{DynamicResource ThemeTextColor}" />
                                            <BoxView
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            BackgroundColor="{DynamicResource ThemeTextColor}"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand" />
                                            <StackLayout
                                                Grid.Row="6"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                Orientation="Horizontal"
                                                TranslationY="6"
                                                VerticalOptions="Fill">
                                                <Frame
                                                    Padding="0"
                                                    BackgroundColor="{DynamicResource ThemeBaseColor}"
                                                    CornerRadius="6"
                                                    HasShadow="False"
                                                    HeightRequest="12"
                                                    Opacity="0.75"
                                                    WidthRequest="120">
                                                    <Label
                                                        FontSize="12"
                                                        Style="{DynamicResource BoldLable}"
                                                        Text="शुभकामनायें भेजें"
                                                        TextColor="White" />
                                                    <Frame.GestureRecognizers>
                                                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="HappyWishes_Tapped" />
                                                    </Frame.GestureRecognizers>
                                                </Frame>
                                            </StackLayout>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="HappyWishesMember_Tapped" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </Frame>
                                </ContentView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </tabview:TabItem>
            </tabview:TabViewControl.ItemSource>
        </tabview:TabViewControl>
        <!-- Show bottom images gurkul, pujari, tiffin, jain hostel -->
        <local:BottamToolBoxView
            Grid.Row="2"
            HeightRequest="100"
            VerticalOptions="End"
            Margin="4,6,4,6"
            Padding="2,2,2,2" />
    </Grid>

</ContentPage>            