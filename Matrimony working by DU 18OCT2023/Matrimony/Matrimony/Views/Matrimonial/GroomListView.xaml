<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Matrimony.Views.Matrimonial.GroomListView"
                              xmlns:vm="clr-namespace:Matrimony.ViewModels" xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms" xmlns:ffimage="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:ffTransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations" xmlns:cell="clr-namespace:Matrimony.Cells" xmlns:local="clr-namespace:Matrimony.NewFolder"
             Title="{Binding Title}" ControlTemplate="{StaticResource MainPageTemplate}">
    <ContentPage.ToolbarItems>
        <!--<ToolbarItem Text="About-us" Order="Secondary" />
        <ToolbarItem Text="Contact-us" Order="Secondary"/>
        <ToolbarItem Text="Help" Order="Secondary"/>-->
    </ContentPage.ToolbarItems>
    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="*,48" RowDefinitions="48" BackgroundColor="Transparent" Margin="0,0,8,0">

            <StackLayout Orientation="Horizontal" Grid.Column="0" HorizontalOptions="CenterAndExpand" VerticalOptions="Center">
                <ffimageloadingsvg:SvgCachedImage  WidthRequest="16" HeightRequest="16" Source="resource://Matrimony.Resources.namaste.svg"/>
                <Label Style="{DynamicResource MediumLable}" TextColor="White" Text="Jain Matrimonials"/>
                <ffimageloadingsvg:SvgCachedImage  WidthRequest="16" HeightRequest="16" Source="resource://Matrimony.Resources.namaste.svg"/>
            </StackLayout>
            <!--<BoxView Grid.Column="1" CornerRadius="26" BackgroundColor="White" WidthRequest="48" HeightRequest="48" />-->
            <!--<Image BackgroundColor="{DynamicResource ThemeBaseColor}" Grid.Column="1" HeightRequest="48" WidthRequest="48" Source="xamarin_logo.png" Aspect="AspectFit">
                <Image.Clip>
                    <EllipseGeometry  Center="26,26" RadiusX="18" RadiusY="18"/>
                </Image.Clip>
            </Image>-->
            <ffimage:CachedImage Margin="2"  Aspect="AspectFit"  Grid.Column="1" HeightRequest="42" WidthRequest="42"  Source="boy">
                <ffimage:CachedImage.Transformations>
                    <ffTransformations:RoundedTransformation CropHeightRatio="42" CropWidthRatio="42" Radius="500" BorderSize="10" BorderHexColor="#FFFFFF"/>
                </ffimage:CachedImage.Transformations>
            </ffimage:CachedImage>

        </Grid>
    </NavigationPage.TitleView>

    <Grid Padding="10,4,10,2" RowDefinitions="60,Auto,*">
        <Grid
                        Grid.Row="0"
                        Padding="12,6,12,0"
                        ColumnDefinitions="40,*,40"
                        HorizontalOptions="FillAndExpand"
                        RowDefinitions="48,Auto"
                        VerticalOptions="Center">
            <Frame
                            Grid.ColumnSpan="2" Grid.Row="0"
                            Padding="8,4,8,4"
                            BorderColor="White"
                            CornerRadius="10"
                            HasShadow="True">
                <StackLayout Orientation="Horizontal">

                    <ffimageloadingsvg:SvgCachedImage
                                    Grid.Column="2"
                                    HeightRequest="12"
                                    Source="resource://Matrimony.Resources.search.svg"
                                    WidthRequest="12" />

                    <Entry
                                    x:Name="txtSearch"
                                    Grid.Column="1"
                                    x:FieldModifier="Public"
                                    Completed="Search_Tapped"
                                    FontSize="12"
                                    HeightRequest="36"
                                    HorizontalOptions="FillAndExpand"
                                    Keyboard="Default"
                                    Placeholder="Search..."
                                    ReturnType="Search"
                                    Style="{DynamicResource RegularEntry}"
                                    Text=""
                                    TextChanged="txtSearch_TextChanged"
                                    TextColor="{DynamicResource ThemeTextColor}" />

                </StackLayout>
            </Frame>
            <ContentView
                            Grid.Column="2"
                            Padding="2"
                            HeightRequest="40">
                <ffimageloadingsvg:SvgCachedImage Grid.Column="2" Source="resource://Matrimony.Resources.add.svg" />
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="AddMember_Tapped" />
                </ContentView.GestureRecognizers>
            </ContentView>

            <Button InputTransparent="False"
                             Grid.Row="0"
                            Grid.Column="1" 
                            BackgroundColor="Transparent"
                            FontSize="12" VerticalOptions="CenterAndExpand"
                            HorizontalOptions="EndAndExpand" TranslationX="16"
                            FontFamily="{StaticResource MediumFont}"
                            Text="खोजें"
                            TextColor="Black" Clicked="AdvanceSearch_Tapped"
                            />

        </Grid>
        <Label Grid.Row="1" TranslationX="10" HorizontalOptions="Start" Text="वर देखें" Style="{DynamicResource BoldLable}" TextColor="{DynamicResource ThemeTextColor}"/>

        <CollectionView HorizontalOptions="FillAndExpand" Grid.Row="2" SelectionMode="None" ItemsSource="{Binding GroomList}"
                        Scrolled="CollectionView_Scrolled" >
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"  />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="No Record Available" Style="{DynamicResource MediumLable}" TextColor="{DynamicResource ThemeTextColor}"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ContentView
                        Margin="10"
                        Padding="2,2"
                        BackgroundColor="Transparent">
                        <Frame
                            Margin="0,0"
                            Padding="2,4,2,4"
                            BackgroundColor="White"
                            BorderColor="White"
                            CornerRadius="10"
                            HasShadow="True">
                            <Grid
                                ColumnDefinitions="Auto,2.5*"
                                ColumnSpacing="14"
                                RowDefinitions="16,14,14,14,14,1,20"
                                RowSpacing="1">
                                <!--<ffimage:CachedImage
                                    Grid.Row="0"
                                    Grid.RowSpan="9"
                                    Grid.Column="0"
                                    Margin="2"
                                    Aspect="AspectFit"
                                    BackgroundColor="Transparent"
                                    Source="{Binding ImageUrl}"
                                    WidthRequest="100">
                                    <ffimage:CachedImage.Transformations>
                                        <ffTransformations:RoundedTransformation
                                            BorderHexColor="#FFFFFF"
                                            BorderSize="0"
                                            Radius="50" />
                                    </ffimage:CachedImage.Transformations>
                                </ffimage:CachedImage>-->

                                <ImageButton
                                    Grid.Row="0"
                                    Grid.RowSpan="7"
                                    Grid.Column="0"
                                    Margin="2"
                                    Aspect="Fill"
                                    BackgroundColor="Transparent"
                                    Clicked="TapGestureRecognizer_Tapped"
                                    CornerRadius="15"
                                    Source="{Binding ImageUrl}"
                                    WidthRequest="100" />



                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontSize="12"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{DynamicResource BoldLable}"
                                    Text="{Binding memberid, StringFormat='JM{0}'}"
                                    TextColor="{DynamicResource ThemeTextColor}" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontSize="10"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{DynamicResource RegularLable}"
                                    Text="{Binding fullname}"
                                    TextColor="{DynamicResource ThemeTextColor}" />

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    FontSize="10"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{DynamicResource RegularLable}"
                                    Text="{Binding GetAgeHeight}"
                                    TextColor="{DynamicResource ThemeTextColor}" />

                                <Label
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    FontSize="10"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{DynamicResource RegularLable}"
                                    Text="{Binding IncomeText, StringFormat='आय | {0}'}"
                                    TextColor="{DynamicResource ThemeTextColor}" />

                                <!--<Label
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    FontSize="10"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{DynamicResource RegularLable}"
                                    Text="{Binding address}"
                                    TextColor="{DynamicResource ThemeTextColor}" />-->

                                <Label
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    FontSize="10"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{DynamicResource RegularLable}"
                                    Text="{Binding GetAddress}"
                                    TextColor="{DynamicResource ThemeTextColor}" />

                                <BoxView
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    BackgroundColor="{DynamicResource ThemeTextColor}"
                                    HeightRequest="1"
                                    HorizontalOptions="FillAndExpand" />

                                <StackLayout
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    Orientation="Horizontal"
                                    TranslationY="6"
                                    VerticalOptions="Fill">
                                    <!--<Frame
                                        Padding="0"
                                        BackgroundColor="{DynamicResource ThemeBaseColor}"
                                        CornerRadius="6"
                                        HasShadow="False"
                                        HeightRequest="12"
                                        Opacity="0.75"
                                        WidthRequest="60">
                                        <Label
                                            FontSize="7"
                                            Style="{DynamicResource MediumLable}"
                                            Text="Short List"
                                            TextColor="White" />
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="ShortList_Tapped" />
                                        </Frame.GestureRecognizers>
                                    </Frame>-->
                                    <Frame
                                        Padding="0"
                                        BackgroundColor="{DynamicResource ThemeBaseColor}"
                                        CornerRadius="6"
                                        HasShadow="False"
                                        HeightRequest="12"
                                        Opacity="0.75"
                                        WidthRequest="80">
                                        <Label
                                            FontSize="12"
                                            Style="{DynamicResource BoldLable}"
                                            Text="संपर्क करें"
                                            TextColor="White" />
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="Chat_Tapped" />
                                        </Frame.GestureRecognizers>
                                    </Frame>
                                    <!--<Frame
                                        Padding="0"
                                        BackgroundColor="{DynamicResource ThemeBaseColor}"
                                        CornerRadius="6"
                                        HasShadow="False"
                                        HeightRequest="12"
                                        Opacity="0.75"
                                        WidthRequest="80">
                                        <Label
                                            FontSize="12"
                                            Style="{DynamicResource BoldLable}"
                                            Text="सन्देश भेजें"
                                            TextColor="White" />
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="SendInterest_Tapped" />
                                        </Frame.GestureRecognizers>
                                    </Frame>-->
                                </StackLayout>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="TapGestureRecognizer_Tapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Frame>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </Grid>

</ContentPage>    